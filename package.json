{
  "name": "gunship",
  "version": "1.0.0",
  "description": "Gunship: Freedom Protocol — browser helicopter roguelite (vanilla ES modules, zero runtime deps)",
  "type": "module",
  "private": true,
  "scripts": {
    "check": "node tools/check.mjs",
    "lint": "node tools/lint.mjs",
    "lint:eslint": "eslint js --ext .js,.mjs",
    "format": "prettier --write \"**/*.{js,mjs,json,css,md}\"",
    "format:check": "prettier --check \"**/*.{js,mjs,json,css,md}\"",
    "dev": "python3 -m http.server 8000"
  },
  "devDependencies": {
    "eslint": "^8.57.0",
    "prettier": "^3.3.3",
    "puppeteer": "^25.9.0"
  },
  "engines": {
    "node": ">=18"
  }
}
